{
  "name": "mcnair-portfolio-site",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "npm run build:portfolio && npm run build:wedding && node scripts/merge-wedding-build.js",
    "test": "react-scripts test",
    "build:portfolio": "react-scripts build",
    "build:wedding": "npm run build --workspace wedding-site",
    "test:wedding": "npm test --workspace wedding-site -- --watchAll=false --runInBand"
  },
  "dependencies": {
    "@azure/msal-browser": "4.30.0",
    "@azure/msal-react": "3.0.29",
    "@tiptap/core": "^2.27.3",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-underline": "^2.27.2",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/react": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.1",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "workspaces": [
    "wedding-site"
  ]
}
